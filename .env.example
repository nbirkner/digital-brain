# ─── Auth ─────────────────────────────────────────────────────────────────────

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# Local dev: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials
# Create at: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google (dev)
#                           https://your-domain.com/api/auth/callback/google (prod)
# NOTE: NextAuth uses AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET (not GOOGLE_CLIENT_ID)
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Only this email can log in. Use your Google account email.
ALLOWED_EMAIL=you@gmail.com

# ─── AI ───────────────────────────────────────────────────────────────────────

# Anthropic API key — required. Used by the Command tab to classify commands.
# Get at: console.anthropic.com → API Keys
# If you use Claude Code, you already have this key — no additional setup needed.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Together AI API key — optional alternative LLM backend
# Only needed if you want to swap the Command tab to use Together AI instead of Claude.
# Get at: api.together.ai → API Keys
# TOGETHER_API_KEY=

# ─── GitHub ───────────────────────────────────────────────────────────────────

# Your fork's repo in "owner/repo" format — used by the unpublish API
# Example: yourname/digital-brain
GITHUB_REPO=yourname/digital-brain

# GitHub personal access token — needed if you use the external pages / publish feature
# Create at: github.com/settings/tokens → Fine-grained → Contents: read/write
GITHUB_TOKEN=ghp_your-token-here

# ─── Todoist (optional — enables task creation) ────────────────────────────────

# Todoist API token
# Get at: todoist.com/app/settings/integrations/developer → API token
TODOIST_API_TOKEN=your-todoist-token

# Todoist project IDs for routing
# Find by: todoist API at https://api.todoist.com/rest/v2/projects (or from app URL)
TODOIST_WORK_PROJECT_ID=your-work-project-id
TODOIST_PERSONAL_PROJECT_ID=your-personal-project-id

# Same as above — needed for client-side components (TaskCreateModal, TasksClient)
NEXT_PUBLIC_TODOIST_WORK_PROJECT_ID=your-work-project-id
NEXT_PUBLIC_TODOIST_PERSONAL_PROJECT_ID=your-personal-project-id
NEXT_PUBLIC_TODOIST_INBOX_PROJECT_ID=your-inbox-project-id

# Shared Todoist project — optional, for tasks shared with a partner or collaborator
# Create a project in Todoist, invite their email, then paste the project ID here
TODOIST_SHARED_PROJECT_ID=your-shared-project-id
NEXT_PUBLIC_TODOIST_SHARED_PROJECT_ID=your-shared-project-id

# ─── Local dev UX (optional) ──────────────────────────────────────────────────

# Absolute path to this repo on your local machine
# Enables "Open in Cursor" link in Notes
# Example: /Users/yourname/Code/digital-brain
NEXT_PUBLIC_REPO_ROOT=
